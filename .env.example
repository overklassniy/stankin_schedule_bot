# Токен бота Telegram (обязательный параметр)
BOT_TOKEN=токен_Telegram_бота

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL (по умолчанию INFO)
LOG_LEVEL=INFO

# ID администраторов Telegram через запятую (для доступа к /settings)
ADMIN_IDS=

# Директория для логов
LOGS_DIR=logs

# Путь к JSON-файлу с полными именами преподавателей
TEACHERS_FULLNAMES_PATH=data/teachers.json

# Директория с изображениями для отправки
IMAGES_DIR=images

# Интервал проверки времени планировщиком в секундах
CHECK_TIME_INTERVAL=30

# Путь к файлу БД SQLite
DATABASE_PATH=data/bot.db

# Ограничить команды только привязанными чатами из БД (true/false, по умолчанию true)
ENABLE_SECURE=true

# Moodle: базовый URL и ID курса с расписаниями
MOODLE_BASE_URL=https://edu.stankin.ru
MOODLE_COURSE_ID=11557

# Кэш расписания: директория и TTL в секундах (по умолчанию 6 часов)
SCHEDULE_CACHE_DIR=data/cache
SCHEDULE_CACHE_TTL=21600

# Прокси для запросов к Telegram API (необязательно)
PROXY=
